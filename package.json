{
	"name": "iris",
	"version": "0.1.0-alpha",
	"private": true,
	"description": "Iris – WordPress AI Assistant frontend.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "tsc -b && vite build --config vite.config.ts",
		"lint": "eslint 'resources/ts/**/*.{ts,tsx}'",
		"format": "prettier --write 'resources/ts/**/*.{ts,tsx}' 'resources/scss/**/*.scss'",
		"zip": "python3 bin/release.py"
	},
	"dependencies": {
		"dompurify": "^3.4.11",
		"marked": "^18.0.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@types/dompurify": "^3.0.5",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.0",
		"prettier": "^3.5.0",
		"sass": "^1.89.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0"
	}
}
